/data/exercises-import.csv
/data/exercises-dataset.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.idea
.zed
scripts/private/
scripts/personal/
product-development/
.claude/
.cache/

# logs & terminal captures
screenlog.*
*.log
